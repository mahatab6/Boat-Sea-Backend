<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Login</title>
</head>
<body>
    <div>
        <p>Redirecting to Google login...</p>
    </div>
</body>

<script>
    (
        async () => {
            try {
                const response = await fetch("/api/auth/sign-in/social", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({ 
                        provider: 'google', 
                        callbackURL: '<%= callbackURL %>' 
                    }),
                });

                const data = await response.json();
                if(data.url) {
                    window.location.href = data.url;
                } else { 
                    console.error('OAuth error:', data);
                    document.body.innerHTML = '<p>Failed to get Google login URL. Please try again later.</p>';
                }
            } catch (error) {
                console.error('Request error:', error);
                document.body.innerHTML = '<p>Failed to redirect to Google login. Please try again later.</p>';
            }
        }
    ) ();
</script>

</html>