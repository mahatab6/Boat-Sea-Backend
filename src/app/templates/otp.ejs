<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
</head>
<body style="font-family: sans-serif; padding: 20px; color: #333; line-height: 1.5; background-color: #f9fafb;">

  <div style="max-width: 500px; margin: 0 auto; border: 1px solid #e5e7eb; border-radius: 12px; padding: 30px; background-color: #ffffff; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
    
    <h2 style="color: #111827; margin-top: 0;">Verification Code</h2>

    <p style="font-size: 16px;">Hello <strong><%= (typeof name !== 'undefined' && name) ? name : 'User' %></strong>,</p>

    <p style="font-size: 15px; color: #4b5563;">Please use the following One-Time Password (OTP) to complete your verification. This code is valid for a limited time.</p>

    <div style="margin: 30px 0; text-align: center;">
      <div style="display: inline-block; padding: 15px 30px; background-color: #f3f4f6; color: #1e40af; font-size: 32px; font-weight: 700; letter-spacing: 5px; border-radius: 8px; border: 1px dashed #2563eb;">
        <%= otp %>
      </div>
    </div>

    <p style="font-size: 14px; color: #ef4444; text-align: center; font-weight: 500;">
      This code will expire in <strong>2 minutes</strong>.
    </p>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 25px 0;">

    <p style="font-size: 13px; color: #9ca3af; text-align: center;">
      If you did not request this code, you can safely ignore this email. Someone may have entered your email address by mistake.
    </p>
  </div>

</body>
</html>