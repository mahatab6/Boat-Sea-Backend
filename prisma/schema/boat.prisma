model Boat {
    id       String @id @default(uuid())
    boatName String @db.VarChar(150)

    boatType BoatType
    status   BoatStatus

    capacity Int
    ownerId  String

    // owner              User     @relation(fields: [ownerId], references: [id])

    boatCondition String
    location      String

    pricePerTrip Int

    length         Float
    width          Float
    engineCapacity Int

    manufacturer      String
    manufacturingYear Int

    amenities          String[]
    cancellationPolicy String

    rating       Float @default(0)
    totalReviews Int   @default(0)

    isApproved Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // schedules          Schedule[]
    // bookings           Booking[]
    reviews     Review[]
    license     License?
    boat_images Boat_Images[]
}
