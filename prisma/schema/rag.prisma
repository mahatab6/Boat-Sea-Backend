model DocumentEmbedding {
  id Int @id @default(autoincrement())

  chunkKey    String  @unique
  chunkIndex  Int
  sourceType  String
  sourceId    String
  sourceLabel String?

  content    String
  tokenCount Int?

  metadata Json?

  embedding Unsupported("vector(2048)")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceType])
  @@index([sourceId])
}
